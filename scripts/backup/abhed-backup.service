# An example unit for scripts/backup/abhed-backup.sh. Copy to
# /etc/systemd/system/, set the paths and the environment file, then
#   systemctl enable --now abhed-backup.timer
[Unit]
Description=Back up the Abhed database and server state
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Holds ABHED_BACKUP_DSN (with no password in it), PGPASSFILE naming a 0600
# password file for that role, ABHED_BACKUP_STATE and ABHED_BACKUP_DIR; mode
# 0600, owned by root.
EnvironmentFile=/etc/abhed/backup.env
ExecStart=/opt/abhed/scripts/backup/abhed-backup.sh
User=abhed-backup
UMask=0077
