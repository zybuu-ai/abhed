# Local workspaces and per-checkout configuration. The dot directory holds
# this checkout's skills and config; a contributor's copy is their own.
.abhed-workspace/
.abhed/
.wrangler/

# Rendered documentation, embedded into the binary by
# scripts/docsite/build.py --embed-only at build time. The markdown in docs/
# is the source; the rendered tree is a build product.
internal/docsite/site/*
!internal/docsite/site/.keep

# Build outputs
bin/
dist/
/abhed
*.test
*.out

# Python bytecode, from the benchmark scripts
__pycache__/
*.pyc
bench/.scratch/
bench/logs/

# Runtime uploads from the web console: user data, never part of the product
uploads/

# Editor, assistant and OS files: not part of the product
.claude/
.DS_Store
.idea/
.vscode/

# Internal notes and raw research are not published
docs/internal/
docs/research/

# benchmark rig: datasets, clones and virtualenvs
bench/rig/.cache/
